{
    "manifest_version": 3,
    "name": "Article Explainer",
    "description": "Highlight any text on an article and get an AI explanation with full article context.",
    "version": "1.0",
    "permissions": ["activeTab", "storage", "scripting"],
    "host_permissions": [
      "<all_urls>",
      "https://generativelanguage.googleapis.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["styles.css"]
      }
    ],
    "action": {
      "default_popup": "popup.html",
      "default_title": "Article Explainer Settings"
    }
  }